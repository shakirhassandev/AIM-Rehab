---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'light' | 'outline'; class?: string; external?: boolean }
const { href, variant = 'primary', class: cls, external = false } = Astro.props;
---
<a class:list={['btn', `btn-${variant}`, cls]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <slot />
  <span class="btn-ic"><Icon name="arrow-up-right" /></span>
</a>
