---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
import { getServices, serviceUrl } from '../lib/content';

const services = await getServices();
---
<div class="drawer" data-drawer aria-hidden="true">
  <div class="drawer-bg" data-menu-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-top">
      <a class="brand" href="/"><Icon name="logo" /><span>{site.name}</span></a>
      <button class="drawer-close" type="button" aria-label="Close menu" data-menu-close><Icon name="close" /></button>
    </div>
    <nav aria-label="Mobile">
      <ul class="drawer-nav">
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="drawer-sub">
                {services.map((s) => <li><a href={serviceUrl(s.id)}>{s.data.cardTitle}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="drawer-contact">
      <a href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
      <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    </div>
  </div>
</div>
