---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { serviceUrl } from '../lib/content';

interface Props { service: CollectionEntry<'services'>; headingLevel?: 'h2' | 'h3' }
const { service, headingLevel = 'h3' } = Astro.props;
const { data } = service;
const H = headingLevel;
---
<article class="svc-card">
  <div class="svc-icon"><Icon name={data.icon} /></div>
  <H><a href={serviceUrl(service.id)}>{data.cardTitle}</a></H>
  <p>{data.summary}</p>
  <div class="svc-media">
    <span class="svc-tab" aria-hidden="true">Read More <Icon name="arrow-right" /></span>
    <Image src={data.image} alt={data.imageAlt} widths={[400, 640, 800]} sizes="(max-width: 767px) 86vw, (max-width: 1023px) 46vw, (max-width: 1399px) 31vw, 330px" quality={74} />
    <span class="svc-foot l" aria-hidden="true"></span>
    <span class="svc-foot r" aria-hidden="true"></span>
  </div>
</article>
