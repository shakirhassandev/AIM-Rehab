const icon = icons[name] ?? icons['arrow-right'];
---
<svg
  class={cls}
  viewBox={icon.vb ?? '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width={icon.sw ?? 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>
