---
import '@fontsource/gotu/400.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Drawer from '../components/Drawer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import defaultOg from '../assets/images/hero-prosthetic-leg-fitting.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = defaultOg, imageAlt, type = 'website', published, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;

const sameAs = Object.values(site.socials).filter(Boolean);
const clinic = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': `${site.url}/#clinic`,
  name: site.name,
  description: site.description,
  url: `${site.url}/`,
  logo: `${site.url}/logo.png`,
  image: ogUrl,
  telephone: site.phone,
  email: site.email,
  contactPoint: site.phones.map((p) => ({ '@type': 'ContactPoint', telephone: p.display, contactType: 'appointments', areaServed: 'PK' })),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.area}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region || undefined,
    postalCode: site.address.postalCode || undefined,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapUrl,
  areaServed: { '@type': 'City', name: site.address.city },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.openingHours.days,
    opens: site.openingHours.opens,
    closes: site.openingHours.closes,
  },
  medicalSpecialty: 'Musculoskeletal',
  availableService: [
    'Lower limb prosthetics', 'Upper limb prosthetics', 'AFO, KAFO and HKAFO braces',
    'Spinal and fracture bracing', 'Pediatric orthotics', 'Custom foot orthotics',
  ].map((name) => ({ '@type': 'MedicalTherapy', name })),
  ...(sameAs.length ? { sameAs } : {}),
};
const jsonLd = [clinic, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#005152" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="hero" />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Drawer />
    <button class="to-top" type="button" aria-label="Back to top" data-to-top><Icon name="arrow-up" /></button>

    <script>
      // Fade sections in as they scroll into view
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Accordions (one open at a time inside each group)
      document.querySelectorAll<HTMLButtonElement>('.acc-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.acc-item')!;
          const group = btn.closest('.accordion');
          const open = !item.classList.contains('is-open');
          group?.querySelectorAll('.acc-item.is-open').forEach((other) => {
            if (other !== item) {
              other.classList.remove('is-open');
              other.querySelector('.acc-btn')?.setAttribute('aria-expanded', 'false');
            }
          });
          item.classList.toggle('is-open', open);
          btn.setAttribute('aria-expanded', String(open));
        });
      });

      // Mobile menu
      const drawer = document.querySelector<HTMLElement>('[data-drawer]');
      const openDrawer = (state: boolean) => {
        if (!drawer) return;
        drawer.classList.toggle('is-open', state);
        drawer.setAttribute('aria-hidden', String(!state));
        document.body.classList.toggle('no-scroll', state);
        document.querySelectorAll('[data-menu-open]').forEach((b) => b.setAttribute('aria-expanded', String(state)));
        if (state) drawer.querySelector<HTMLElement>('[data-menu-close]')?.focus();
      };
      document.querySelectorAll('[data-menu-open]').forEach((b) => b.addEventListener('click', () => openDrawer(true)));
      document.querySelectorAll('[data-menu-close]').forEach((b) => b.addEventListener('click', () => openDrawer(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') openDrawer(false); });

      // Back to top
      const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
      const onScroll = () => toTop?.classList.toggle('is-visible', window.scrollY > 700);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0 }));
    </script>
  </body>
</html>
